kvmd:
  auth:
    expire: 14400
{% if ansible_os_family != 'Archlinux' %}
    allow_redirects:
      - /
      - /avm
      - /avm/
      - /kvm
      - /kvm/
{% endif %}
  msd:
    type: disabled
  atx:
    type: disabled
  hid:
    mouse:
{% if ansible_os_family != 'Archlinux' %}
      absolute: true
{% else %}
      absolute: false
{% endif %}
    mouse_alt:
      device: ""

otg:
  manufacturer: "Dell Inc."
  product: "Dell U2723QE Hub"
  vendor_id: 0x413c
  product_id: 0x2113
  serial: "CN0123456789ABCDEF00"
  devices:
    hid:
      keyboard:
        start: true
      mouse:
        start: true
      mouse_alt:
        start: false
    msd:
      start: false
    ethernet:
      enabled: false
      start: false
    serial:
      enabled: false
      start: false
    audio:
      enabled: true
      start: true
      speakers:
        enabled: false
      mic:
        enabled: true

